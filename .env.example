# RedactX production configuration. Copy to .env (or pass with `docker run --env-file`).
# The server only READS this file; it never writes to the user/system environment.

# --- model / mode ---------------------------------------------------------------------------
# Exported checkpoint directory (must contain config.json). Required for hybrid / redactx modes.
REDACTX_MODEL_DIR=./models/RedactX-v2
# hybrid (RedactX + Presidio union, recommended) | redactx | presidio
REDACTX_MODE=hybrid
# cpu | cuda | cuda:0  (empty = cuda if available)
REDACTX_DEVICE=

# --- redaction ------------------------------------------------------------------------------
# tag ([NAME]) | mask ([REDACTED]) | char (*****) | pseudonym ([NAME_3f2a9c1b], needs HMAC key)
REDACTX_STRATEGY=tag
# What to do when RedactX flags a document but cannot localize any span:
#   redact_all -> whole document replaced by [REDACTED_DOCUMENT] (fail closed)
#   review     -> text returned with localized findings redacted and action=REVIEW for a human
REDACTX_UNLOCALIZED_POLICY=redact_all
# 32+ hex chars or 16+ byte secret. Generate: python -c "import secrets; print(secrets.token_hex(32))"
REDACTX_HMAC_KEY=
# 1 = redact only the 18 HIPAA Safe Harbor identifier categories
REDACTX_HIPAA_ONLY=0
# 1 = include original PHI values in API findings (avoid in production)
REDACTX_RETURN_FINDING_TEXT=0
# Presidio minimum score
REDACTX_PRESIDIO_SCORE=0.35

# --- authentication -------------------------------------------------------------------------
# Comma-separated SHA-256 hashes of API keys. Generate a key + hash with:  redactx hash-key
REDACTX_API_KEY_HASHES=
# 1 = no authentication (local development only)
REDACTX_ALLOW_NO_AUTH=0
# Explicit browser origins, comma-separated ('*' is rejected). Empty = CORS disabled.
REDACTX_CORS_ORIGINS=

# --- limits ---------------------------------------------------------------------------------
REDACTX_MAX_CHARS=100000
REDACTX_MAX_BATCH=32
REDACTX_MAX_BODY_BYTES=4000000
REDACTX_RATE_LIMIT_PER_MIN=120
REDACTX_RATE_BURST=30
REDACTX_REQUEST_TIMEOUT_S=60
# Concurrent inference jobs (1 per GPU is usually right) and how many more may wait before 503.
REDACTX_MAX_CONCURRENCY=1
REDACTX_MAX_QUEUE=16

# --- long documents / batching --------------------------------------------------------------
REDACTX_CHUNK_CHARS=600
REDACTX_CHUNK_OVERLAP=150
REDACTX_BATCH_SIZE=8

# --- logging --------------------------------------------------------------------------------
# '-' = stdout, or a file path. Audit lines contain counts/categories/latency only, never text.
REDACTX_AUDIT_LOG=-
